@model tl2_recuperacionparcial2_Gonz0x.ViewModels.PeliculaCreateViewModel

<h2>Crear Tarea</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Titulo Pelicula</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label  class="form-label" asp-for="Anio" >Anio</label>
        <input type="number" asp-for="Anio" class="form-control-sm">        
        <span asp-validation-for="Anio" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Categoria"></label>
        <select asp-for="Categoria" asp-items="Model.ListaCategorias" class="form-control"></select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>
</div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
 <partial name="_ValidationScriptsPartial" />
}
