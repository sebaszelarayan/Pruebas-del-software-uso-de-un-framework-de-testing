@model tl2_recuperacionparcial2_Gonz0x.ViewModels.TareaCreateViewModel

<h2>Crear Tarea</h2>

<form asp-action="Create" method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label">Titulo Tarea</label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
        <div class="mb-3">
        <label asp-for="Descripcion" class="form-label">Descripcion Tarea</label>
        <input asp-for="Descripcion" class="form-control" />
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label  class="form-label" asp-for="Complejidad" >Complejidad</label>
        <input type="number" asp-for="Complejidad" class="form-control-sm">        
        <span asp-validation-for="Complejidad" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Estado"></label>
        <select asp-for="Estado" asp-items="Model.ListaEstados" class="form-control"></select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
</div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
 <partial name="_ValidationScriptsPartial" />
}
